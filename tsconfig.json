{
    "compilerOptions": {
        // Default react config
        "target": "es5",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        // Added for the library configuration
        "jsx": "react",
        "module": "ESNext",
        "declaration": true,
        "sourceMap": false,
        "outDir": "dist",
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "emitDeclarationOnly": false,
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "e2e-tests",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/__tests__"
    ]
}