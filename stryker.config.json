{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "_comment": "Stryker Mutation Testing Configuration for Blueprint Micro Interaction Components",
    "testRunner": "jest",
    "reporters": [
        "json",
        "clear-text",
        "progress"
    ],
    "mutate": [
        "src/components/**/*.tsx",
        "!src/components/**/*.test.tsx",
        "!src/components/**/*.stories.tsx",

        "!src/components/**/index.tsx",
        "!src/components/DXGenericCatalog/utilities/CatalogItems.tsx"
    ],
    "mutator": {
        "excludedMutations": [
            "OptionalChaining"
        ]
    },
    "thresholds": {
        "high": 80,
        "low": 70,
        "break": 65
    },
    "coverageAnalysis": "perTest",
    "jest": {
        "projectType": "custom",
        "configFile": "jest.config.js",
        "enableFindRelatedTests": true
    },
    "ignoreStatic": true,
    "timeoutMS": 60000,
    "timeoutFactor": 1.5,
    "dryRunTimeoutMinutes": 20,
    "concurrency": 8,
    "incremental": true,
    "incrementalFile": "src/__tests__/mutation/stryker-incremental.json",
    "disableTypeChecks": "{src,test}/**/*.{js,ts,jsx,tsx}",
    "ignorePatterns": [
        "dist",
        "node_modules",
        ".storybook",

        "test-report",
        "coverage",
        "**/*.d.ts"
    ]
}