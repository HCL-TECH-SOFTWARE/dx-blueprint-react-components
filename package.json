    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3": "7.4.3",
    "@types/jest": "27.5.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-slick": "0.23.13",
    "@typescript-eslint/eslint-plugin": "8.70.1",
