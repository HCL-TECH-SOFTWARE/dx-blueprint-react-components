    "hasha": "5.2.2",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-html-reporters": "2.1.6",
    "jest-junit": "16.0.0",
    "jest-reporter-log-validator": "0.1.6",
    "jest-svg-transformer": "1.0.0",
    "postcss": "8.5.28",
    "postcss-url": "10.1.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rollup": "4.63.2",
