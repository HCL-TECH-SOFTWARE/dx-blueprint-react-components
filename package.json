{
  "name": "@hcl-software/dx-blueprint-react-components",
  "version": "1.0.0",
  "description": "HCL DX Blueprint React component library",
  "homepage": "https://hcl-tech-software.github.io/dx-blueprint-react-components/",
  "scripts": {
    "build": "npm run build:lib",
    "build:lib": "rollup -c",
    "build:storybook": "storybook build",
    "dev": "storybook dev -p 6006",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:tokens": "node scripts/check-css-tokens.mjs",
    "test:unit": "jest --runInBand",
    "test:mutation": "bash scripts/test-mutation.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HCL-TECH-SOFTWARE/dx-blueprint-react-components.git"
  },
  "author": "Ronald Angelo Reyes <ronaldangelo.reyes@hcl-software.com>",
  "license": "Apache-2.0",
  "engines": {
    "npm": ">=11.10.0"
  },
  "bugs": {
    "url": "https://github.com/HCL-TECH-SOFTWARE/dx-blueprint-react-components/issues"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-image": "3.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
