  "module": "dist/esm/index.js",
  "umd": "dist/umd/index.js",
  "files": [
    "dist",
    "THIRD-PARTY-LICENSES"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./tokens.css": "./dist/css/tokens.css",
    "./components.css": "./dist/css/components.css",
    "./bootstrap.css": "./dist/css/bootstrap.css",
    "./index.css": "./dist/cjs/index.css",
    "./dist/cjs/index.css": "./dist/cjs/index.css",
    "./dist/esm/index.css": "./dist/esm/index.css",
    "./dist/umd/index.js": "./dist/umd/index.js",
    "./dist/umd/index.css": "./dist/umd/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "1.4.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "d3": "7.9.0",
    "dompurify": "3.4.15",
    "html-react-parser": "5.2.17",
    "react-bootstrap": "2.10.10",
    "react-data-table-component": "7.5.3",
    "react-horizontal-scrolling-menu": "3.2.5",
    "react-slick": "0.31.0",
    "slick-carousel": "1.8.1",
    "styled-components": "6.5.3",
    "typed.js": "2.1.0"
  },
  "overrides": {
    "styled-components": {
      "@babel/traverse": "7.23.2"
    },
    "d3": {
      "d3-color": "3.1.0"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
